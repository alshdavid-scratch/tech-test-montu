{
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["DOM", "ESNext", "ESNext.AsyncIterable", "ESNext.Array"],
    "strict": true,
    "noEmit": true,
    "experimentalDecorators": false,
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "jsx": "react",
    "jsxFactory": "h",
    "types": ["./types/modules.d.ts"]
  },
  "include": ["src", "test"]
}
